{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "mcp.[YOUR_DOMAIN]",
  "Urls": "http://127.0.0.1:5080",
  "Auth": {
    "Enabled": true,
    "Authority": "[IDENTITY_PROVIDER_ISSUER_URL]",
    "Audience": "[MCP_SERVER_AUDIENCE]",
    "PublicBaseUrl": "https://mcp.[YOUR_DOMAIN]",
    "ScopesSupported": [
      "github.read",
      "sql.read",
      "postgres.read",
      "mongo.read",
      "postman.read"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Modules": {
    "Postman": {
      "Enabled": false,
      "BaseUrl": "https://api.getpostman.com/",
      "AllowedWorkspaceIds": [
        "[POSTMAN_WORKSPACE_ID]"
      ],
      "AllowWrite": false,
      "AllowDelete": false,
      "MaxResults": 50,
      "ExtraDeniedKeys": [],
      "Credentials": {
        "Token": "[POSTMAN_API_KEY]"
      }
    },
    "GitHub": {
      "Enabled": false,
      "BaseUrl": "https://api.github.com/",
      "AllowedOwners": [
        "[YOUR_GITHUB_ORG]"
      ],
      "MaxResults": 30,
      "MaxFileChars": 50000,
      "Credentials": {
        "Token": "[GITHUB_FINE_GRAINED_TOKEN]"
      },
      "AllowWrite": false,
      "AllowDelete": false,
      "AllowMerge": false,
      "AllowCommitToProtectedBranches": false
    },
    "Sql": {
      "Enabled": false,
      "MaxRows": 200,
      "CommandTimeoutSeconds": 15,
      "ExtraDeniedColumns": [],
      "Connections": {
        "Orders": {
          "Description": "Orders database",
          "AllowWrite": false,
          "AllowDelete": false
        }
      },
      "Credentials": {
        "Connections": {
          "Orders": {
            "ConnectionString": "[SQLSERVER_READONLY_CONNECTION_STRING]"
          }
        }
      }
    },
    "Postgres": {
      "Enabled": false,
      "MaxRows": 200,
      "CommandTimeoutSeconds": 15,
      "ExtraDeniedColumns": [],
      "Connections": {
        "Reporting": {
          "Description": "Reporting replica",
          "AllowWrite": false,
          "AllowDelete": false
        }
      },
      "Credentials": {
        "Connections": {
          "Reporting": {
            "ConnectionString": "[POSTGRES_READONLY_CONNECTION_STRING]"
          }
        }
      }
    },
    "Mongo": {
      "Enabled": false,
      "MaxRows": 200,
      "CommandTimeoutSeconds": 15,
      "ExtraDeniedColumns": [],
      "Connections": {
        "Events": {
          "Database": "events",
          "Description": "Event store",
          "AllowWrite": false,
          "AllowDelete": false
        }
      },
      "Credentials": {
        "Connections": {
          "Events": {
            "ConnectionString": "[MONGODB_READONLY_CONNECTION_STRING]"
          }
        }
      }
    }
  }
}
