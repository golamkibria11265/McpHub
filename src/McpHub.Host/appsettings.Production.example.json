{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "mcp.[YOUR_DOMAIN]",
  "Urls": "http://127.0.0.1:5080",

  "Auth": {
    "Enabled": true,
    "Authority": "[IDENTITY_PROVIDER_ISSUER_URL]",
    "Audience": "[MCP_SERVER_AUDIENCE]",
    "PublicBaseUrl": "https://mcp.[YOUR_DOMAIN]",
    "ScopesSupported": [ "github.read" ]
  },

  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },

  "Modules": {
    "GitHub": {
      "Enabled": true,
      "BaseUrl": "https://api.github.com/",
      "AllowedOwners": [ "[YOUR_GITHUB_ORG]" ],
      "MaxResults": 30,
      "MaxFileChars": 50000
    }
  },

  "Credentials": {
    "GitHub": {
      "Token": "[GITHUB_FINE_GRAINED_TOKEN]"
    }
  }
}
