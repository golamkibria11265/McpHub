{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",

  "Auth": {
    "Enabled": false,
    "Authority": "",
    "Audience": "",
    "PublicBaseUrl": "",
    "ScopesSupported": [ "github.read" ]
  },

  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },

  "Modules": {
    "GitHub": {
      "Enabled": true,
      "BaseUrl": "https://api.github.com/",
      "AllowedOwners": [ "[YOUR_GITHUB_ORG_OR_USER]" ],
      "MaxResults": 30,
      "MaxFileChars": 50000
    }
  },

  "Credentials": {
    "GitHub": {
      "Token": "[GITHUB_FINE_GRAINED_TOKEN]"
    }
  }
}
