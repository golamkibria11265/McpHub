{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",

  "Auth": {
    "Enabled": false,
    "Authority": "",
    "Audience": "",
    "PublicBaseUrl": "",
    "ScopesSupported": [ "github.read", "sql.read", "postgres.read", "mongo.read", "postman.read", "postman.write", "postman.delete" ]
  },

  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },

  "Modules": {
    "GitHub": {
      "Enabled": true,
      "BaseUrl": "https://api.github.com/",
      "AllowedOwners": [ "[YOUR_GITHUB_ORG_OR_USER]" ],
      "MaxResults": 30,
      "MaxFileChars": 50000,
      "Credentials": {
        "Token": "[GITHUB_FINE_GRAINED_TOKEN]"
      }
    },
    "Postman": {
      "Enabled": false,
      "BaseUrl": "https://api.getpostman.com/",
      "AllowedWorkspaceIds": [ "[POSTMAN_WORKSPACE_ID]" ],
      "AllowWrite": false,
      "AllowDelete": false,
      "MaxResults": 50,
      "ExtraDeniedKeys": [],
      "Credentials": {
        "Token": "[POSTMAN_API_KEY]"
      }
    },
    "Sql": {
      "Enabled": false,
      "MaxRows": 200,
      "CommandTimeoutSeconds": 15,
      "ExtraDeniedColumns": [],
      "Connections": {
        "Orders": { "Description": "Orders database (SQL Server, read-only login)" }
      },
      "Credentials": {
        "Connections": {
          "Orders": { "ConnectionString": "[SQLSERVER_READONLY_CONNECTION_STRING]" }
        }
      }
    },
    "Postgres": {
      "Enabled": false,
      "MaxRows": 200,
      "CommandTimeoutSeconds": 15,
      "ExtraDeniedColumns": [],
      "Connections": {
        "Reporting": { "Description": "Reporting replica (PostgreSQL, read-only role)" }
      },
      "Credentials": {
        "Connections": {
          "Reporting": { "ConnectionString": "[POSTGRES_READONLY_CONNECTION_STRING]" }
        }
      }
    },
    "Mongo": {
      "Enabled": false,
      "MaxRows": 200,
      "CommandTimeoutSeconds": 15,
      "ExtraDeniedColumns": [],
      "Connections": {
        "Events": { "Database": "events", "Description": "Event store (MongoDB, read-only user)" }
      },
      "Credentials": {
        "Connections": {
          "Events": { "ConnectionString": "[MONGODB_READONLY_CONNECTION_STRING]" }
        }
      }
    }
  }
}
